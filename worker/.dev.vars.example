# Copy this file to .dev.vars (which is gitignored) and fill in your real values.
#
#   cp .dev.vars.example .dev.vars
#
# `wrangler dev` will load these into the Worker environment automatically.
# This worker is a stateless forwarder; all upstream API keys live in vibe-id.

# Shared secret used to authenticate calls from this worker to vibe-id's
# /v1/* endpoints. Must match VIBE_ID_INTERNAL_KEY in the vibe-id worker.
VIBE_ID_INTERNAL_KEY="dev-internal-key-change-me"

# Override the public vibe-id base URL for local dev so requests go to the
# locally-running vibe-id wrangler dev process.
VIBE_ID_BASE_URL="http://127.0.0.1:8790"
