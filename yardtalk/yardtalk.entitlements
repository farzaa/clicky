<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  YardTalk ships via Developer ID + notarization, not the Mac App Store:
	  its global hotkeys (⌃⌥D/⌃⌥V/⌃⌥M) rely on a system-wide key monitor that
	  the App Sandbox forbids. So there is intentionally NO app-sandbox key.
	  Hardened Runtime is enabled in build settings; the keys below are the
	  Hardened Runtime "resource access" entitlements for the hardware the app
	  actually uses. Network access and arbitrary file access need no
	  entitlement outside the sandbox.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
