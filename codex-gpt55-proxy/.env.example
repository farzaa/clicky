# Local Clicky GPT-5.5 proxy configuration
# Add your Deepgram key to .env as DEEPGRAM_API_KEY, or configure the Agent Vault broker variables from README.md.
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_TTS_ENCODING=mp3

# Optional Codex/GPT-5.5 proxy settings
PORT=8877
CODEX_MODEL=gpt-5.5
# CODEX_AUTH_FILE=~/.codex/auth.json
