# Copy to scripts/release.env and replace every placeholder with real beta values.
# Do not commit scripts/release.env. Secrets still belong in Wrangler, not here.

export SPIDER_APPCAST_URL="https://<release-host>/spider/appcast.xml"
export SPIDER_WORKER_BASE_URL="https://<api-host>"
export SPIDER_LOGIN_CONFIRM_URL="https://<api-host>/auth/login/confirm"
export SPIDER_STRIPE_SUCCESS_URL="https://<app-host>/account"
export SPIDER_STRIPE_CANCEL_URL="https://<app-host>/account"
export SPIDER_D1_DATABASE_ID="<cloudflare-d1-database-uuid>"

# Required only when preparing a GitHub Release/DMG artifact.
export SPIDER_RELEASE_REPO="owner/spider-mac-app"

# Optional release-time settings.
export SPIDER_NOTARY_PROFILE="AC_PASSWORD"
export SPIDER_DEVELOPMENT_TEAM="<apple-team-id>"
